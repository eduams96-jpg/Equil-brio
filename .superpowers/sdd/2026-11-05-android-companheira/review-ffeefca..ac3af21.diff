+    + '<small class="agenda-state">' + e(t.status) + (t.estimated ? ' · Estimativa' : '') + '</small>'
+    + (t.occurrenceNote ? '<p class="sub">' + e(t.occurrenceNote) + '</p>' : '')
+    + (t.agendaSource === 'Compromisso' ? '<button type="button" class="commit-open" data-commitment="' + e(t.id) + '">Abrir compromisso</button>' : '') + '</div>'
+    + '<span class="amount">' + (t.type === 'transfer' ? '↔ ' : t.type === 'expense' ? '−' : '+') + kit.money(t.amountCents, ctx.state.hidden) + '</span></article>';
+}
+
+// Agenda do mês. view: {period, showCompleted}.
+function render(ctx, view = {}) {
+  const period = view.period || ctx.today.slice(0, 7), showCompleted = !!view.showCompleted, hidden = ctx.state.hidden;
+  const result = Agenda.agenda(ctx.ledger, period, ctx.today, showCompleted);
+  const tiles = '<div class="ch-tiles">'
+    + '<article class="ch-tile is-red"><span class="ch-tile-icon">' + icon('alert') + '</span><span class="ch-tile-label">A pagar</span><strong class="ch-tile-value" data-agenda-pay>' + kit.money(result.payCents, hidden) + '</strong></article>'
+    + '<article class="ch-tile is-green"><span class="ch-tile-icon">' + icon('check') + '</span><span class="ch-tile-label">A receber</span><strong class="ch-tile-value" data-agenda-receive>' + kit.money(result.receiveCents, hidden) + '</strong></article>'
+    + '</div>';
+  return banners(ctx.state) + back('mais', '‹ Mais') + '<h1>Agenda</h1><p class="sub">Compromissos, recorrências e subscrições deste mês.</p>'
+    + periodControls(ctx.ledger, period, ctx.today)
+    + '<button type="button" id="new-commitment" class="primary full">+ Novo compromisso</button>'
+    + tiles
+    + '<p class="sub">' + result.pendingCount + ' por concluir' + (result.estimated ? ' · Inclui estimativas' : '') + '. Valores previstos; o saldo só muda com movimentos registados.</p>'
+    + '<label class="agenda-check"><input id="agenda-completed" type="checkbox" ' + (showCompleted ? 'checked' : '') + '> Mostrar recorrências e subscrições concluídas</label>'
+    + '<div class="agenda-list">' + (result.rows.map(t => entry(ctx, t)).join('') || '<p class="empty">Sem compromissos previstos neste mês.</p>') + '</div>';
+}
+
+function originalDetail(ctx, commitmentId) {
+  const e = kit.escape, ledger = ctx.ledger, r = ledger.pendingPayments.find(t => t.id === commitmentId);
+  if (!r) return '<button data-page="agenda">‹ Agenda</button><h1>Compromisso indisponível</h1>';
+  return back('agenda', '‹ Agenda') + '<h1>' + e(r.description) + '</h1>'
+    + '<section class="review-card"><p class="review-value">' + kit.money(P.Finance.cents(r.amount), ctx.state.hidden) + '</p>'
+    + '<p>' + e(V.dateLabel(r.date)) + ' · ' + e(r.account || 'Conta não indicada') + '</p><small>' + e(r.category || 'Outros') + '</small></section>'
+    + (Commitments.editable(ledger, r)
+      ? '<div class="review-actions"><button id="edit-commitment" class="primary">Editar compromisso</button><button id="reschedule-commitment">Reagendar</button></div>'
+      : '<p class="note">Este compromisso exige gestão especializada.</p>')
+    + (r.reschedules && r.reschedules.length
+      ? '<h2>Histórico de reagendamento</h2><ul class="commit-history">' + r.reschedules.map(x => '<li>' + e(V.dateLabel(x.from)) + ' → ' + e(V.dateLabel(x.to)) + '<p>' + e(x.reason) + '</p></li>').join('') + '</ul>' : '');
+}
+
+// Detalhe do compromisso e pagamentos já registados. view: {commitmentId}.
+function commitment(ctx, view = {}) {
+  const ledger = ctx.ledger, id = view.commitmentId;
+  const t = ledger.pendingPayments.find(x => x.id === id), paid = ledger.transactions.filter(x => x.pendingId === id);
+  let html = t ? originalDetail(ctx, id) : '<button data-page="agenda">‹ Agenda</button><h1>' + (paid.length ? 'Compromisso liquidado' : 'Compromisso indisponível') + '</h1>';
+  if (t && Commitments.payable(ledger, t)) html += '<button id="open-payment" class="primary full">' + (t.type === 'income' ? 'Registar recebimento' : 'Registar pagamento') + '</button>';
+  if (paid.length) html += '<h2>Pagamentos registados</h2>' + paid.map(x => row(ctx, x)).join('');
+  return html;
+}
+
+// Formulário de compromisso (novo, editar, reagendar). view: {form, record}.
+function form(ctx, view = {}) {
+  const e = kit.escape, cf = view.form, cr = view.record;
+  if (!cf || !cr) return '<p>Compromisso indisponível.</p>';
+  const accounts = ctx.ledger.accounts.filter(a => !a.archived), available = accounts.some(a => a.id === cf.accountId), reason = K.reason(ctx.state, cr);
+  const sel = (value, mine) => value === mine ? 'selected' : '';
+  return back('agenda', '‹ Agenda') + '<h1>' + (cf.command === 'commitment.add' ? 'Novo compromisso' : cf.action === 'reschedule' ? 'Reagendar compromisso' : 'Editar compromisso') + '</h1>'
+    + '<p class="sub">Guardar atualiza a previsão. O saldo mantém-se até registares o pagamento ou recebimento.</p>'
+    + '<form id="commitment-form"><label>Tipo<select name="type"><option value="expense" ' + sel(cf.type, 'expense') + '>Despesa</option><option value="income" ' + sel(cf.type, 'income') + '>Receita</option></select></label>'
+    + '<label>Descrição<input name="description" maxlength="120" required value="' + e(cf.description) + '"></label>'
+    + '<label>Valor (€)<input name="amount" inputmode="decimal" required value="' + e(cf.amount) + '"></label>'
+    + '<label>Conta<select name="accountId">' + (!available ? '<option value="' + e(cf.accountId) + '" selected>Conta indisponível · escolhe outra</option>' : '')
+    + accounts.map(a => '<option value="' + e(a.id) + '" ' + sel(a.id, cf.accountId) + '>' + e(a.name) + '</option>').join('') + '</select></label>'
+    + '<label>Data prevista<input name="date" type="date" required value="' + e(cf.date) + '"></label>'
+    + '<label>Categoria<input name="category" maxlength="120" required value="' + e(cf.category) + '" placeholder="Ex.: Casa / Renda"></label>'
+    + (cf.command === 'commitment.update'
+      ? '<label>Motivo do reagendamento (se mudares a data)<textarea name="reason" maxlength="500" rows="3">' + e(cf.reason) + '</textarea></label>'
+      : '<input name="reason" type="hidden" value="">')
+    + '<p id="commitment-status" role="status">' + (cr.sequence ? 'Rascunho guardado neste dispositivo.' : 'O preenchimento é guardado como rascunho.') + '</p>'
+    + (reason ? '<p class="note">' + e(reason) + '</p>' : '')
+    + '<button type="button" class="primary full" id="save-commitment">Guardar compromisso</button>'
+    + '<button id="ask-discard-commitment" class="full" type="button">Descartar rascunho</button></form>';
+}
+
+// Registo de pagamento ou recebimento. view: {form, record}.
+function payment(ctx, view = {}) {
+  const e = kit.escape, pf = view.form, pr = view.record;
+  if (!pf) return '<p>Pagamento indisponível.</p>';
+  const t = ctx.ledger.pendingPayments.find(x => x.id === pf.id), reason = Forms.staleReason(ctx.state, pr);
+  return back('agenda', '‹ Agenda') + '<h1>' + (t && t.type === 'income' ? 'Registar recebimento' : 'Registar pagamento') + '</h1>'
+    + '<p>' + e(t ? t.description : 'Compromisso indisponível') + '</p>'
+    + '<p>Por liquidar: <strong>' + (t ? kit.money(P.Finance.cents(t.amount), ctx.state.hidden) : 'Indisponível') + '</strong></p>'
+    + '<p class="sub">Confirma apenas dinheiro que já entrou ou saiu. Num pagamento parcial, o restante continua na Agenda.</p>'
+    + '<form id="payment-form"><label>Valor (€)<input name="amount" inputmode="decimal" required value="' + e(pf.amount) + '"></label>'
+    + '<label>Data efetiva<input name="date" type="date" required max="' + e(ctx.today) + '" value="' + e(pf.date) + '"></label>'
+    + '<p id="payment-status" role="status">' + (pr.sequence ? 'Rascunho guardado neste dispositivo.' : 'O preenchimento será guardado neste dispositivo.') + '</p>'
+    + (reason ? '<p class="note">' + e(reason) + '</p>' : '')
+    + '<button id="save-payment" type="button" class="primary full">Confirmar registo</button>'
+    + '<button id="ask-discard-payment" class="full" type="button">Descartar rascunho</button></form>';
+}
+
+function discardCommitment() {
+  return '<h1>Descartar o rascunho do compromisso?</h1><p>O preenchimento por concluir será removido. Os compromissos e movimentos guardados mantêm-se.</p>'
+    + '<div class="review-actions"><button data-page="agenda">Manter rascunho</button><button id="confirm-discard-commitment">Descartar rascunho</button></div>';
+}
+
+function discardPayment() {
+  return '<h1>Descartar o pagamento por concluir?</h1><p>O compromisso e os pagamentos guardados mantêm-se.</p>'
+    + '<button data-page="agenda">Manter rascunho</button><button id="confirm-discard-payment">Descartar rascunho</button>';
+}
+
+module.exports = { render, commitment, form, payment, discardCommitment, discardPayment };
diff --git a/android/app/src/screens/agenda.test.cjs b/android/app/src/screens/agenda.test.cjs
new file mode 100644
index 0000000..babad7a
--- /dev/null
+++ b/android/app/src/screens/agenda.test.cjs
@@ -0,0 +1,79 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const agenda = require('./agenda.cjs');
+const { ctx, demo, empty } = require('./fixtures.cjs');
+const P = require('../../../shared/protocol.cjs');
+const K = require('../../../shared/commitment-drafts.cjs');
+const Forms = require('../../../shared/form-drafts.cjs');
+
+const AMOUNT = /\d,\d{2}\s?€/;
+const view = { period: '2026-11', showCompleted: false };
+const realCtx = (ledger, hidden = false) => ctx(ledger, { state: { ...P.offlineFixture(), hidden } });
+
+test('Agenda não atira com dados vazios e de demonstração', () => {
+  for (const make of [empty, demo]) {
+    const c = realCtx(make());
+    assert.ok(agenda.render(c, view).includes('id="new-commitment"'));
+    assert.ok(agenda.commitment(c, { commitmentId: 'pp-rent' }).length > 0);
+    assert.ok(agenda.discardCommitment().includes('id="confirm-discard-commitment"'));
+    assert.ok(agenda.discardPayment().includes('id="confirm-discard-payment"'));
+  }
+});
+
+test('Agenda do demo lista os compromissos do mês e volta a Mais', () => {
+  const html = agenda.render(realCtx(demo()), view);
+  assert.ok(html.includes('Renda') && html.includes('Internet'));
+  assert.equal((html.match(/data-commitment="/g) || []).length, 2);
+  assert.ok(html.includes('data-agenda-pay') && html.includes('data-agenda-receive'));
+  assert.ok(html.includes('data-page="mais"'));
+  assert.ok(html.includes('id="agenda-completed"'));
+  assert.doesNotMatch(html, /id="agenda-completed"[^>]*checked/);
+  assert.match(agenda.render(realCtx(demo()), { ...view, showCompleted: true }), /id="agenda-completed"[^>]*checked/);
+});
+
+test('Agenda vazia avisa que não há compromissos', () => {
+  assert.ok(agenda.render(realCtx(empty()), view).includes('Sem compromissos previstos'));
+});
+
+test('Agenda com valores ocultos não mostra montantes (e mostra-os quando visíveis)', () => {
+  assert.match(agenda.render(realCtx(demo()), view), AMOUNT);
+  assert.doesNotMatch(agenda.render(realCtx(demo(), true), view), AMOUNT);
+  assert.match(agenda.commitment(realCtx(demo()), { commitmentId: 'pp-rent' }), AMOUNT);
+  assert.doesNotMatch(agenda.commitment(realCtx(demo(), true), { commitmentId: 'pp-rent' }), AMOUNT);
+});
+
+test('Detalhe do compromisso tem ações e trata compromisso em falta', () => {
+  const html = agenda.commitment(realCtx(demo()), { commitmentId: 'pp-rent' });
+  for (const s of ['Renda', 'id="edit-commitment"', 'id="reschedule-commitment"', 'id="open-payment"', 'data-page="agenda"']) assert.ok(html.includes(s), s);
+  assert.ok(agenda.commitment(realCtx(demo()), { commitmentId: 'nao-existe' }).includes('Compromisso indisponível'));
+});
+
+test('Formulário de compromisso tem os campos e ids usados pelos manipuladores', () => {
+  const c = realCtx(demo());
+  const form = { id: 'c1', command: 'commitment.add', action: 'edit', type: 'expense', description: 'Seguro', amount: '12,50', accountId: c.ledger.accounts[0].id, date: '2026-11-20', category: 'Casa', reason: '', changedOn: '2026-11-05' };
+  const html = agenda.form(c, { form, record: K.create(c.state, form, 0) });
+  for (const s of ['id="commitment-form"', 'id="save-commitment"', 'id="ask-discard-commitment"', 'id="commitment-status"', 'name="accountId"', 'name="reason"', 'Novo compromisso']) assert.ok(html.includes(s), s);
+  const upd = agenda.form(c, { form: { ...form, command: 'commitment.update', action: 'reschedule' }, record: K.create(c.state, form, 0) });
+  assert.ok(upd.includes('Reagendar compromisso') && upd.includes('<textarea name="reason"'));
+  assert.ok(agenda.form(c, { form: null, record: null }).includes('Compromisso indisponível'));
+});
+
+test('Formulário de pagamento tem os campos e ids usados pelos manipuladores', () => {
+  const c = realCtx(demo());
+  const form = { id: 'pp-rent', transactionId: 't1', amount: '520,00', date: '2026-11-05', changedOn: '2026-11-05' };
+  const html = agenda.payment(c, { form, record: Forms.create(c.state, form, 'commitment:pp-rent', 0) });
+  for (const s of ['id="payment-form"', 'id="save-payment"', 'id="ask-discard-payment"', 'id="payment-status"', 'name="amount"', 'name="date"', 'max="2026-11-05"', 'Renda']) assert.ok(html.includes(s), s);
+  assert.ok(agenda.payment(c, { form: null, record: null }).includes('Pagamento indisponível'));
+  // o valor por liquidar fora do campo de edição respeita a ocultação
+  const strip = h => h.replace(/value="[^"]*"/g, '');
+  assert.match(strip(html), AMOUNT);
+  const hc = realCtx(demo(), true);
+  assert.doesNotMatch(strip(agenda.payment(hc, { form, record: Forms.create(hc.state, form, 'commitment:pp-rent', 0) })), AMOUNT);
+});
+
+test('Banners de rascunho de pagamento e compromisso aparecem na Agenda', () => {
+  const state = { ...P.offlineFixture(), hidden: false, paymentDraft: { token: 't' }, commitmentDraft: { token: 'c' } };
+  const html = agenda.render(ctx(demo(), { state }), view);
+  assert.ok(html.includes('id="resume-payment"') && html.includes('id="resume-commitment"'));
+});
diff --git a/android/app/src/screens/casa.cjs b/android/app/src/screens/casa.cjs
new file mode 100644
index 0000000..c11c377
--- /dev/null
+++ b/android/app/src/screens/casa.cjs
@@ -0,0 +1,144 @@
+'use strict';
+const kit = require('../ui/kit.cjs');
+const V = require('../view-model.cjs');
+const H = require('../../../shared/house.cjs');
+const Forms = require('../../../shared/form-drafts.cjs');
+const { priceLabel } = require('../house-ui.cjs');
+
+const NO_PLACE = 'Sem local definido';
+
+// Pills do topo: «Lista de compras» abre o seu próprio ecrã; as outras trocam o separador desta página.
+const PILLS = [
+  ['compras', 'Lista de compras', 'data-page="compras"'],
+  ['produtos', 'Produtos', 'data-house-tab="produtos"'],
+  ['stock', 'Stock', 'data-house-tab="stock"'],
+];
+
+function pills(tab) {
+  return '<div class="cs-pills" role="tablist">' + PILLS.map(([id, label, attr]) =>
+    '<button type="button" role="tab" ' + attr + ' aria-pressed="' + (id === tab ? 'true' : 'false') + '">' + label + '</button>').join('') + '</div>';
+}
+
+function rowButton(attr, id, title, detail, aside) {
+  const e = kit.escape;
+  return '<button type="button" class="row movement-row" ' + attr + '="' + e(id) + '"><div><strong>' + e(title) + '</strong><small>' + e(detail) + '</small></div><span>' + e(aside) + '</span></button>';
+}
+
+function banner(state) {
+  return state.houseDraft
+    ? '<section class="draft-banner"><strong>Tens um artigo Casa por concluir</strong><button id="resume-house">Retomar preenchimento</button><button id="ask-discard-house">Descartar rascunho</button></section>' : '';
+}
+
+function productPage(ctx, c, p) {
+  const e = kit.escape, hidden = ctx.state.hidden;
+  const back = '<button class="back" data-house-tab="produtos">‹ Produtos</button>';
+  if (!p) return back + '<h1>Produto indisponível</h1>';
+  const offers = Object.entries(p.offers || {}).map(([storeId, offer]) => ({ storeId, ...offer, per: offer.price / offer.packageQty }))
+    .sort((a, b) => (a.price > 0 ? 0 : 1) - (b.price > 0 ? 0 : 1) || a.per - b.per);
+  const offerCards = offers.map(o => '<section class="review-card"><strong>' + e((c.stores.find(s => s.id === o.storeId) || {}).name || 'Supermercado') + '</strong>'
+    + '<p>' + o.packageQty + ' ' + e(p.unit) + ' · ' + (o.price > 0 ? kit.money(Math.round(o.price * 100), hidden) : 'Falta colocar preço') + '</p>'
+    + '<small>' + (o.price > 0 ? priceLabel(p.unit, o, hidden) : 'Sem comparação por unidade') + ' · ' + e(V.dateLabel(o.date)) + '</small>'
+    + (o.url ? '<a class="product-link" href="' + e(o.url) + '" target="_blank" rel="noopener noreferrer">Abrir neste supermercado ↗</a>' : '') + '</section>').join('');
+  const lots = c.stock.filter(l => l.catalogId === p.id).map(l =>
+    rowButton('data-lot', l.id, l.location || NO_PLACE, l.expiry ? V.dateLabel(l.expiry) : 'Sem validade indicada', H.Life.remaining(c, l) + ' ' + l.unit)).join('');
+  return back + '<h1>' + e(p.name) + '</h1><p>' + [p.brand, p.category, p.unit].filter(Boolean).map(e).join(' · ') + '</p>'
+    + (p.url ? '<a class="product-link" href="' + e(p.url) + '" target="_blank" rel="noopener noreferrer">Abrir link do produto ↗</a>' : '')
+    + '<button class="full" data-edit-product="' + e(p.id) + '">Editar produto e preços</button>'
+    + '<h2>Preços por supermercado</h2>' + (offerCards || '<p class="empty">Sem preços registados. Adiciona-os ao editar o produto.</p>')
+    + '<h2>Lotes e destinos</h2><button class="primary full" data-new-lot="' + e(p.id) + '">+ Adicionar stock</button>' + lots;
+}
+
+function lotPage(ctx, c, lot) {
+  const e = kit.escape;
+  const product = lot && c.catalog.find(p => p.id === lot.catalogId);
+  const back = '<button class="back" data-product="' + e(product ? product.id : '') + '">‹ Produto</button>';
+  if (!lot) return back + '<h1>Lote indisponível</h1>';
+  const labels = { consume: 'Consumo', waste: 'Desperdício' };
+  const events = c.stockEvents.filter(x => x.lotId === lot.id).map(x =>
+    '<div class="info-line"><span>' + e(V.dateLabel(x.date)) + ' · ' + e(labels[x.type] || 'Acerto') + '<small>' + e(x.note || '') + '</small></span><strong>' + x.delta + ' ' + e(lot.unit) + '</strong></div>').join('');
+  return back + '<h1>' + e(product ? product.name : 'Lote indisponível') + '</h1>'
+    + '<section class="review-card"><p class="review-value">' + H.Life.remaining(c, lot) + ' ' + e(lot.unit) + '</p><p>' + e(lot.location || NO_PLACE) + '</p>'
+    + '<p>' + (lot.expiry ? 'Validade: ' + e(V.dateLabel(lot.expiry)) : 'Sem validade indicada') + '</p></section>'
+    + '<div class="review-actions"><button data-edit-lot="' + e(lot.id) + '">Alterar destino e validade</button><button data-consume-lot="' + e(lot.id) + '" class="primary">Consumir / desperdício</button></div>'
+    + '<h2>Histórico do lote</h2>' + (events || '<p class="empty">Ainda sem consumo.</p>');
+}
+
+function productsBody(c) {
+  const list = c.catalog.filter(p => !p.archived).map(p => rowButton('data-product', p.id, p.name, (p.category || 'Sem categoria') + ' · ' + H.Life.available(c, p.id) + ' ' + p.unit, '›')).join('');
+  return '<button id="new-product" class="primary full">+ Criar produto</button>'
+    + (list ? kit.card({ title: 'Produtos', subtitle: c.catalog.filter(p => !p.archived).length + ' no catálogo', body: list }) : '<p class="empty">Ainda sem produtos. Começa por criar um produto.</p>');
+}
+
+function stockBody(c) {
+  const places = [...new Set(c.stock.map(l => l.location || NO_PLACE))].sort();
+  return places.map(place => {
+    const lots = c.stock.filter(l => (l.location || NO_PLACE) === place && H.Life.remaining(c, l) > 0);
+    return lots.length ? kit.card({
+      title: place, subtitle: lots.length + (lots.length === 1 ? ' artigo' : ' artigos'),
+      body: lots.map(l => rowButton('data-lot', l.id, (c.catalog.find(p => p.id === l.catalogId) || {}).name || 'Produto',
+        l.expiry ? 'Validade: ' + V.dateLabel(l.expiry) : 'Sem validade indicada', H.Life.remaining(c, l) + ' ' + l.unit)).join(''),
+    }) : '';
+  }).join('');
+}
+
+function shoppingBody(c) {
+  const open = c.shopping.filter(s => !s.done).length;
+  return kit.card({
+    title: 'Lista de compras', subtitle: open + (open === 1 ? ' artigo por comprar' : ' artigos por comprar'),
+    body: '<button type="button" class="primary full" data-page="compras">Abrir lista de compras</button>',
+  });
+}
+
+// Ecrã Casa. view: {tab: 'compras'|'produtos'|'stock' (ou 'produto'|'lote' nos detalhes), id}.
+function render(ctx, view = {}) {
+  const tab = view.tab || 'produtos', id = view.id;
+  const c = H.Casa.state(ctx.ledger);
+  if (tab === 'produto') return banner(ctx.state) + productPage(ctx, c, c.catalog.find(p => p.id === id));
+  if (tab === 'lote') return banner(ctx.state) + lotPage(ctx, c, c.stock.find(l => l.id === id));
+  const body = tab === 'compras' ? shoppingBody(c) : tab === 'stock' ? stockBody(c) : productsBody(c);
+  return banner(ctx.state) + '<h1>Casa</h1><p class="sub">Compras e stock · dados guardados neste dispositivo</p>' + pills(tab)
+    + (body || '<p class="empty">Ainda sem registos nesta vista. Começa por criar um produto.</p>');
+}
+
+// Formulário de produto, lote ou consumo. view: {form, record}. Os ids e names são os que main.js já usa.
+function form(ctx, view = {}) {
+  const e = kit.escape, f = view.form, hr = view.record;
+  if (!f) return '<p>Formulário indisponível.</p>';
+  const reason = Forms.staleReason(ctx.state, hr);
+  const field = (name, label, extra = '') => '<label>' + label + '<input name="' + name + '" value="' + e(f[name] || '') + '" ' + extra + '></label>';
+  let body = '';
+  if (f.command === 'house.product') {
+    const units = H.Casa.stockUnits.map(([id, label]) => '<option value="' + id + '" ' + (f.unit === id ? 'selected' : '') + '>' + e(label) + '</option>').join('');
+    const offers = f.offers.map((o, i) => '<fieldset data-offer-row><legend>Preço ' + (i + 1) + '</legend>'
+      + [['storeName', 'Supermercado'], ['packageQty', 'Quantidade da embalagem'], ['price', 'Preço (€), opcional'], ['url', 'Link neste supermercado']].map(([k, label]) =>
+        '<label>' + label + '<input name="offer-' + i + '-' + k + '" data-offer-field="' + k + '" value="' + e(o[k] == null ? '' : o[k]) + '" '
+        + (k === 'storeName' ? 'maxlength="160"' : k === 'url' ? 'type="url" maxlength="2048" placeholder="https://…"' : 'inputmode="decimal"') + '></label>').join('')
+      + '<button data-remove-offer="' + i + '" type="button">Retirar este preço do formulário</button></fieldset>').join('');
+    body = field('name', 'Nome', 'required maxlength="160"') + field('brand', 'Marca', 'maxlength="80"') + field('category', 'Categoria', 'required')
+      + field('sub1', 'Subcategoria 1') + field('sub2', 'Subcategoria 2') + field('sub3', 'Subcategoria 3')
+      + '<label>Unidade de stock<select name="unit">' + units + '</select></label>'
+      + '<h2>Preços por supermercado</h2><p class="sub">A quantidade usa a unidade de stock escolhida. Deixa o preço vazio se ainda não o sabes; o link pertence a este supermercado.</p>'
+      + offers + '<button id="add-offer" type="button">+ Adicionar supermercado</button>';
+  } else if (f.command === 'house.lot') {
+    body = (f.mode === 'create' ? field('qty', 'Quantidade', 'inputmode="decimal" required') : '<p>Alterar o destino mantém a quantidade original e os consumos.</p>')
+      + field('location', 'Destino do produto', 'required maxlength="80" list="stock-places"')
+      + '<datalist id="stock-places"><option>Despensa</option><option>Frigorífico</option><option>Congelador</option></datalist>'
+      + field('expiry', 'Validade (opcional)', 'type="date"');
+  } else {
+    body = '<label>Registo<select name="type"><option value="consume" ' + (f.type === 'consume' ? 'selected' : '') + '>Consumo</option><option value="waste" ' + (f.type === 'waste' ? 'selected' : '') + '>Desperdício</option></select></label>'
+      + field('qty', 'Quantidade', 'inputmode="decimal" required') + field('note', 'Motivo (opcional)', 'maxlength="500"');
+  }
+  return '<button class="back" data-page="casa">‹ Casa</button><h1>' + (f.command === 'house.product' ? 'Produto e preços' : f.command === 'house.lot' ? 'Lote de stock' : 'Registar consumo') + '</h1>'
+    + '<form id="house-form">' + body
+    + '<p id="house-status" role="status">' + (hr.sequence ? 'Rascunho guardado neste dispositivo.' : 'O preenchimento será guardado neste dispositivo.') + '</p>'
+    + (reason ? '<p class="note">' + e(reason) + '</p>' : '')
+    + '<button class="primary full" id="save-house" type="button">Guardar</button>'
+    + '<button id="ask-discard-house" class="full" type="button">Descartar rascunho</button></form>';
+}
+
+function discard() {
+  return '<h1>Descartar o preenchimento Casa?</h1><p>Os produtos e o stock guardados mantêm-se.</p>'
+    + '<button data-page="casa">Manter rascunho</button><button id="confirm-discard-house">Descartar rascunho</button>';
+}
+
+module.exports = { render, form, discard };
