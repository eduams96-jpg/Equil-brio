+++ b/android/app/src/screens/relatorios.cjs
@@ -0,0 +1,165 @@
+'use strict';
+const kit = require('../ui/kit.cjs');
+const R = require('../../../../equilibrio/reports-model.js');
+
+const KINDS = [['m', 'Mês'], ['q', 'Trimestre'], ['year', 'Ano']];
+const MONTHS = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
+const SHORT = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
+
+const cents = x => Math.round((Number(x) || 0) * 100);
+const two = n => String(n).padStart(2, '0');
+
+function kindOf(period) {
+  if (/^m\d\d$/.test(period)) return 'm';
+  if (/^q\d$/.test(period)) return 'q';
+  return 'year';
+}
+
+// Seleção inicial: o mês corrente de ctx.today, todas as contas.
+function initial(today) {
+  const t = String(today || '');
+  return { year: t.slice(0, 4), period: 'm' + t.slice(5, 7), account: '' };
+}
+
+// Recua (-1) ou avança (+1) um mês, trimestre ou ano; atravessa a fronteira do ano.
+function shift(sel, dir) {
+  const kind = kindOf(sel.period);
+  let year = Number(sel.year);
+  if (kind === 'year') return { ...sel, year: String(year + dir), period: 'year' };
+  const size = kind === 'm' ? 12 : 4;
+  let n = Number(sel.period.slice(1)) + dir;
+  if (n < 1) { n = size; year -= 1; }
+  if (n > size) { n = 1; year += 1; }
+  return { ...sel, year: String(year), period: kind === 'm' ? 'm' + two(n) : 'q' + n };
+}
+
+// Muda entre Mês, Trimestre e Ano mantendo o ano; de «Ano» para outra vista usa o mês de hoje se o ano coincidir.
+function switchKind(sel, kind, today) {
+  const from = kindOf(sel.period);
+  if (from === kind) return sel;
+  if (kind === 'year') return { ...sel, period: 'year' };
+  let month = 1;
+  if (from === 'm') month = Number(sel.period.slice(1));
+  else if (from === 'q') month = (Number(sel.period.slice(1)) - 1) * 3 + 1;
+  else if (String(today || '').slice(0, 4) === String(sel.year)) month = Number(String(today).slice(5, 7)) || 1;
+  return { ...sel, period: kind === 'm' ? 'm' + two(month) : 'q' + Math.ceil(month / 3) };
+}
+
+function label(sel) {
+  const kind = kindOf(sel.period);
+  if (kind === 'm') return MONTHS[Number(sel.period.slice(1)) - 1] + ' de ' + sel.year;
+  if (kind === 'q') return sel.period.slice(1) + '.º trimestre de ' + sel.year;
+  return sel.year;
+}
+
+// Pura: período atual e anterior, diferenças (do saldo) e categorias com cor e subcategorias.
+function view(ledger, sel, analyse = R.analyse) {
+  const current = analyse(ledger, sel);
+  const previous = analyse(ledger, shift(sel, -1));
+  const diff = (a, b) => (cents(a) - cents(b)) / 100;
+  const saving = diff(current.saving, previous.saving);
+  const delta = {
+    income: diff(current.income, previous.income),
+    expense: diff(current.expense, previous.expense),
+    saving,
+    pct: previous.saving ? saving / Math.abs(previous.saving) * 100 : null,
+  };
+  const categories = R.detail(ledger, { ...sel, result: current }).categories.map((c, i) => ({
+    name: c.name,
+    value: c.amount,
+    color: R.color(i),
+    children: c.children.map(ch => ({ name: ch.name, value: ch.amount })),
+  }));
+  return { current, previous, delta, categories };
+}
+
+function pct(v) {
+  return v == null || !Number.isFinite(v) ? '' : (v > 0 ? '+' : '') + v.toLocaleString('pt-PT', { maximumFractionDigits: 0 }) + ' %';
+}
+
+function controls(ctx, sel) {
+  const e = kit.escape;
+  const accounts = (ctx.ledger.accounts || []).filter(a => !a.archived);
+  return kit.pills('repkind', KINDS.map(([value, text]) => ({ value, label: text })), kindOf(sel.period))
+    + '<div class="rep-step"><button type="button" id="rep-prev" aria-label="Período anterior">‹</button>'
+    + '<strong aria-live="polite">' + e(label(sel)) + '</strong>'
+    + '<button type="button" id="rep-next" aria-label="Período seguinte">›</button></div>'
+    + (accounts.length > 1 ? kit.pills('repaccount', [{ value: '', label: 'Todas' }, ...accounts.map(a => ({ value: String(a.id), label: a.name }))], String(sel.account || '')) : '');
+}
+
+function tiles(ctx, v, sel) {
+  const hidden = ctx.state.hidden;
+  const money = x => kit.money(cents(x), hidden);
+  const diff = (v.delta.saving > 0 && !hidden ? '+' : '') + money(v.delta.saving);
+  const p = pct(v.delta.pct);
+  return '<div class="ch-tiles">'
+    + kit.tile({ tone: 'green', icon: 'plus', label: 'Receitas', value: money(v.current.income) })
+    + kit.tile({ tone: 'red', icon: 'cart', label: 'Despesas', value: money(v.current.expense) })
+    + kit.tile({ tone: v.current.saving < 0 ? 'red' : 'blue', icon: 'account', label: 'Saldo', value: money(v.current.saving) })
+    + kit.tile({ tone: 'purple', icon: 'chart', label: 'Diferença', value: diff, detail: (p ? p + ' ' : '') + 'face a ' + label(shift(sel, -1)) })
+    + '</div>';
+}
+
+// Barra horizontal em SVG: a cor vai em atributo de apresentação (a CSP não admite style="").
+function bar(width, color) {
+  const w = Math.max(0, Math.min(100, width)).toFixed(1);
+  return '<svg class="rep-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">'
+    + '<rect class="rep-track" width="100" height="8"/><rect width="' + w + '" height="8" fill="' + kit.escape(color) + '"/></svg>';
+}
+
+function categories(ctx, v, open) {
+  const e = kit.escape;
+  const total = v.current.expense;
+  const top = v.categories.reduce((m, c) => Math.max(m, c.value), 0);
+  const money = x => kit.money(cents(x), ctx.state.hidden);
+  if (!v.categories.length) return kit.card({ title: 'Onde gastas', body: '<p class="empty">Sem despesas neste período.</p>' });
+  const rows = v.categories.map(c => {
+    const share = total > 0 ? Math.round(c.value / total * 100) : 0;
+    const isOpen = open === c.name;
+    const kids = isOpen
+      ? '<div class="rep-kids">' + c.children.map(ch => '<div class="rep-kid"><span>' + e(ch.name) + '</span><span class="amount">' + money(ch.value) + '</span></div>').join('') + '</div>'
+      : '';
+    return '<div class="rep-cat' + (isOpen ? ' is-open' : '') + '">'
+      + '<button type="button" class="rep-cat-head" data-rep-cat="' + e(c.name) + '" aria-expanded="' + isOpen + '">'
+      + '<span class="rep-cat-line"><svg class="rep-dot" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><rect width="10" height="10" fill="' + e(c.color) + '"/></svg>'
+      + '<strong>' + e(c.name) + '</strong><span class="amount">' + money(c.value) + '</span></span>'
+      + bar(top > 0 ? c.value / top * 100 : 0, c.color)
+      + '<small>' + share + ' % das despesas</small></button>' + kids + '</div>';
+  }).join('');
+  return kit.card({ title: 'Onde gastas', subtitle: 'Toca numa categoria para ver as subcategorias', body: rows });
+}
+
+function months(v, sel) {
+  const list = v.current.months;
+  if (kindOf(sel.period) === 'm' || !list.length) return '';
+  const W = 300, H = 120, base = 100, slot = W / list.length, bw = Math.min(14, slot * 0.34);
+  const max = list.reduce((m, x) => Math.max(m, x.income, x.expense), 0);
+  const h = x => (max > 0 ? Math.round(x / max * (base - 6) * 10) / 10 : 0);
+  const parts = list.map((m, i) => {
+    const mid = slot * i + slot / 2, hi = h(m.income), he = h(m.expense);
+    return '<rect class="rep-inc" x="' + (mid - bw - 0.5).toFixed(1) + '" y="' + (base - hi) + '" width="' + bw.toFixed(1) + '" height="' + hi + '"/>'
+      + '<rect class="rep-exp" x="' + (mid + 0.5).toFixed(1) + '" y="' + (base - he) + '" width="' + bw.toFixed(1) + '" height="' + he + '"/>'
+      + '<text class="rep-axis" x="' + mid.toFixed(1) + '" y="' + (H - 6) + '" text-anchor="middle">' + SHORT[Number(m.month.slice(5, 7)) - 1] + '</text>';
+  }).join('');
+  const svg = '<svg class="rep-chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Receitas e despesas mês a mês" focusable="false">'
+    + '<line class="rep-base" x1="0" x2="' + W + '" y1="' + base + '" y2="' + base + '"/>' + parts + '</svg>'
+    + '<p class="rep-legend"><span class="rep-key is-inc">Receitas</span><span class="rep-key is-exp">Despesas</span></p>';
+  return kit.card({ title: 'Mês a mês', subtitle: label(sel), body: svg });
+}
+
+// Ecrã «Relatórios». sel: {year, period, account, open?}, gerido por main.js.
+function render(ctx, sel, analyse = R.analyse) {
+  const s = { ...initial(ctx.today), ...(sel || {}) };
+  let body;
+  try {
+    const v = view(ctx.ledger, s, analyse);
+    body = tiles(ctx, v, s) + categories(ctx, v, s.open) + months(v, s);
+  } catch (error) {
+    body = kit.errorCard(error.message);
+  }
+  return '<button type="button" class="back" data-page="mais">‹ Mais</button><h1>Relatórios</h1>'
+    + '<p class="sub">' + kit.escape(kit.syncStamp(ctx.lastSync, new Date())) + '</p>'
+    + controls(ctx, s) + body;
+}
+
+module.exports = { initial, shift, switchKind, label, view, render };
diff --git a/android/app/src/screens/relatorios.test.cjs b/android/app/src/screens/relatorios.test.cjs
new file mode 100644
index 0000000..8b4ab74
--- /dev/null
+++ b/android/app/src/screens/relatorios.test.cjs
@@ -0,0 +1,132 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const relatorios = require('./relatorios.cjs');
+const R = require('../../../../equilibrio/reports-model.js');
+const { ctx, demo, empty } = require('./fixtures.cjs');
+
+const AMOUNT = /\d,\d{2}\s?€/;
+const NOV = { year: '2026', period: 'm11', account: '' };
+const realCtx = (ledger, hidden = false) => ctx(ledger, { state: { hidden } });
+
+test('view(demo) coincide com R.analyse e o período anterior é o mês anterior', () => {
+  const ledger = demo();
+  const v = relatorios.view(ledger, { year: '2026', period: 'm10' });
+  assert.deepEqual(v.current, R.analyse(ledger, { year: '2026', period: 'm10' }));
+  assert.deepEqual(v.previous, R.analyse(ledger, { year: '2026', period: 'm09' }));
+});
+
+test('o anterior de m01 é m12 do ano anterior; de q1 é q4; do ano é o ano anterior', () => {
+  const calls = [];
+  const spy = (ledger, sel) => { calls.push(sel); return R.analyse(ledger, sel); };
+  relatorios.view(demo(), { year: '2026', period: 'm01', account: '' }, spy);
+  relatorios.view(demo(), { year: '2026', period: 'q1', account: '' }, spy);
+  relatorios.view(demo(), { year: '2026', period: 'year', account: '' }, spy);
+  assert.deepEqual(calls.filter((_, i) => i % 2 === 1).map(s => s.year + s.period), ['2025m12', '2025q4', '2025year']);
+});
+
+test('shift passa as fronteiras do ano nos dois sentidos', () => {
+  const s = (year, period) => ({ year, period, account: '' });
+  assert.deepEqual(relatorios.shift(s('2026', 'm01'), -1), s('2025', 'm12'));
+  assert.deepEqual(relatorios.shift(s('2026', 'm12'), 1), s('2027', 'm01'));
+  assert.deepEqual(relatorios.shift(s('2026', 'q1'), -1), s('2025', 'q4'));
+  assert.deepEqual(relatorios.shift(s('2026', 'q4'), 1), s('2027', 'q1'));
+  assert.deepEqual(relatorios.shift(s('2026', 'year'), -1), s('2025', 'year'));
+  assert.equal(relatorios.shift({ ...s('2026', 'm05'), account: '7' }, 1).account, '7');
+});
+
+test('switchKind converte entre mês, trimestre e ano', () => {
+  const s = (period, year = '2026') => ({ year, period, account: '' });
+  assert.equal(relatorios.switchKind(s('m11'), 'q', '2026-11-05').period, 'q4');
+  assert.equal(relatorios.switchKind(s('q2'), 'm', '2026-11-05').period, 'm04');
+  assert.equal(relatorios.switchKind(s('m11'), 'year', '2026-11-05').period, 'year');
+  assert.equal(relatorios.switchKind(s('year'), 'm', '2026-11-05').period, 'm11');
+  assert.equal(relatorios.switchKind(s('year', '2025'), 'm', '2026-11-05').period, 'm01');
+  assert.equal(relatorios.switchKind(s('m11'), 'm', '2026-11-05').period, 'm11');
+  assert.deepEqual(relatorios.initial('2026-11-05'), NOV);
+});
+
+test('delta é a diferença do saldo face ao período anterior, com percentagem', () => {
+  const v = relatorios.view(demo(), NOV);
+  assert.equal(v.current.saving, 1385.2);
+  assert.equal(v.previous.saving, -48.5);
+  assert.equal(v.delta.saving, 1433.7);
+  assert.equal(v.delta.income, 1450);
+  assert.equal(v.delta.expense, 16.3);
+  assert.equal(Math.round(v.delta.pct), 2956);
+  assert.equal(relatorios.view(empty(), NOV).delta.pct, null);
+});
+
+test('as categorias trazem a cor do modelo por posição e as subcategorias', () => {
+  const v = relatorios.view(demo(), NOV);
+  assert.deepEqual(v.categories.map(c => c.name), ['Alimentação']);
+  assert.equal(v.categories[0].value, 64.8);
+  assert.equal(v.categories[0].color, R.color(0));
+  assert.equal(R.color(0), '#2f9e83');
+  assert.ok(v.categories[0].children.length > 0);
+  const year = relatorios.view(demo(), { year: '2026', period: 'year', account: '' });
+  year.categories.forEach((c, i) => assert.equal(c.color, R.color(i)));
+});
+
+test('erro do modelo mostra o cartão de erro e mantém os seletores', () => {
+  const boom = () => { throw new Error('Ajuste sem direção impede calcular este saldo.'); };
+  const html = relatorios.render(realCtx(demo()), NOV, boom);
+  assert.match(html, /Não foi possível calcular: Ajuste sem direção/);
+  assert.ok(html.includes('data-pill-repkind="year"'));
+  assert.ok(!html.includes('ch-tile'));
+});
+
+test('ledger vazio e demo não atiram, em todos os períodos', () => {
+  for (const make of [empty, demo]) {
+    for (const period of ['m01', 'm11', 'q4', 'year']) {
+      const html = relatorios.render(realCtx(make()), { year: '2026', period, account: '' });
+      assert.ok(html.includes('Relatórios') && !html.includes('cs-error'), period);
+    }
+  }
+  assert.ok(relatorios.render(realCtx(empty()), NOV).includes('Sem despesas neste período'));
+});
+
+test('seletor de período, contas, mosaicos e carimbo de sincronização', () => {
+  const html = relatorios.render(realCtx(demo()), NOV);
+  for (const part of ['data-pill-repkind="m"', 'data-pill-repkind="q"', 'data-pill-repkind="year"', 'id="rep-prev"', 'id="rep-next"', 'data-pill-repaccount=""', 'novembro de 2026', 'Receitas', 'Despesas', 'Saldo', 'Diferença', 'Onde gastas', 'data-page="mais"', 'Ainda não sincronizado']) {
+    assert.ok(html.includes(part), part);
+  }
+  assert.ok(html.includes('data-pill-repkind="m"') && /data-pill-repkind="m" aria-pressed="true"/.test(html));
+});
+
+test('«Mês a mês» só aparece em trimestre e ano', () => {
+  const at = period => relatorios.render(realCtx(demo()), { year: '2026', period, account: '' });
+  assert.ok(!at('m11').includes('Mês a mês'));
+  assert.ok(at('q4').includes('Mês a mês'));
+  assert.equal((at('year').match(/class="rep-inc"/g) || []).length, 12);
+  assert.equal((at('q4').match(/class="rep-inc"/g) || []).length, 3);
+});
+
+test('tocar numa categoria expande as subcategorias', () => {
+  const closed = relatorios.render(realCtx(demo()), NOV);
+  const open = relatorios.render(realCtx(demo()), { ...NOV, open: 'Alimentação' });
+  assert.ok(closed.includes('aria-expanded="false"') && !closed.includes('rep-kid'));
+  assert.ok(open.includes('aria-expanded="true"') && open.includes('rep-kid'));
+});
+
+test('o ecrã não usa style= (a CSP bloqueia-o) e desenha cores em atributos SVG', () => {
+  for (const period of ['m11', 'q4', 'year']) {
+    const html = relatorios.render(realCtx(demo()), { year: '2026', period, account: '', open: 'Alimentação' });
+    assert.ok(!/style\s*=/i.test(html), period);
+  }
+  assert.ok(relatorios.render(realCtx(demo()), NOV).includes('fill="#2f9e83"'));
+});
+
+test('com valores ocultos não há montantes, nem em aria-label', () => {
+  for (const period of ['m11', 'q4', 'year']) {
+    const sel = { year: '2026', period, account: '', open: 'Alimentação' };
+    // dentes: o mesmo ecrã visível tem montantes e a expressão apanha-os
+    assert.match(relatorios.render(realCtx(demo(), false), sel), AMOUNT, period);
+    const html = relatorios.render(realCtx(demo(), true), sel);
+    assert.doesNotMatch(html, AMOUNT, period);
+    assert.ok(html.includes('•••• €'));
+    for (const label of html.match(/aria-label="[^"]*"/g) || []) assert.doesNotMatch(label, /\d,\d{2}|€/, label);
+  }
+  const emptyHtml = relatorios.render(realCtx(empty(), true), NOV);
+  assert.doesNotMatch(emptyHtml, AMOUNT);
+});
