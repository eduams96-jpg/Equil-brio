+    kit.tile({ tone: counts.notices > 0 ? 'red' : 'amber', icon: 'bell', label: 'Avisos', value: count(counts.notices), detail: 'O que merece atenção', page: 'avisos' }),
+    kit.tile({ tone: 'blue', icon: 'calendar', label: 'Agenda', value: count(agendaCount), detail: 'Por tratar em ' + MONTHS[Number(period.slice(5)) - 1], page: 'agenda' }),
+    kit.tile({ tone: 'green', icon: 'cart', label: 'Lista de compras', value: count(counts.shopping), detail: 'Artigos por comprar', page: 'compras' }),
+  ].join('');
+  return '<h1>Resumo</h1><p class="sub">' + kit.escape(kit.syncStamp(ctx.lastSync, new Date())) + '</p>'
+    + periodControls(ledger, period, ctx.today)
+    + '<section class="balance"><span>Saldo total · todas as contas</span><strong>' + kit.money(stats.balanceCents, hidden) + '</strong><small>' + kit.escape(note) + '</small></section>'
+    + '<div class="pair"><div class="stat"><small>Gastos do mês</small><span class="amount">' + kit.money(stats.expenseCents, hidden) + '</span></div>'
+    + '<div class="stat"><small>Rendimentos do mês</small><span class="amount">' + kit.money(stats.incomeCents, hidden) + '</span></div></div>'
+    + '<p class="month-result">Resultado do mês <strong>' + kit.money(stats.resultCents, hidden) + '</strong></p>'
+    + '<div class="ch-tiles is-three">' + tiles + '</div>'
+    + '<button type="button" class="primary full" data-page="novo">+ Novo movimento</button>'
+    + '<div class="section-heading"><h2>Últimos movimentos</h2><button type="button" id="see-month" class="text-button">Ver todos</button></div>'
+    + (recent.map(t => row(ctx, t)).join('') || '<p class="empty">Ainda não há movimentos.</p>');
+}
+
+module.exports = { render, periodControls };
diff --git a/android/app/src/screens/resumo.test.cjs b/android/app/src/screens/resumo.test.cjs
new file mode 100644
index 0000000..cc23ed6
--- /dev/null
+++ b/android/app/src/screens/resumo.test.cjs
@@ -0,0 +1,35 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const resumo = require('./resumo.cjs');
+const { ctx, demo, empty } = require('./fixtures.cjs');
+
+test('Resumo com dados vazios não atira e explica que não há movimentos', () => {
+  const html = resumo.render(ctx(empty()));
+  assert.ok(html.includes('Ainda não há movimentos'));
+});
+
+test('Resumo com dados de demonstração tem 3 mosaicos e no máximo 5 movimentos', () => {
+  const html = resumo.render(ctx(demo()));
+  assert.equal((html.match(/class="ch-tile /g) || []).length, 3);
+  const rows = (html.match(/movement-row/g) || []).length;
+  assert.ok(rows >= 1 && rows <= 5, 'linhas: ' + rows);
+  const pages = [...html.matchAll(/class="ch-tile [^"]*" data-page="([^"]+)"/g)].map(m => m[1]);
+  assert.deepEqual(pages, ['avisos', 'agenda', 'compras']);
+});
+
+test('Resumo mostra «—» quando os contadores são nulos e o número quando existem', () => {
+  const nulls = resumo.render(ctx(demo(), { counts: { notices: null, shopping: null } }));
+  assert.equal((nulls.match(/ch-tile-value">—</g) || []).length, 2);
+  const withCounts = resumo.render(ctx(demo(), { counts: { notices: 4, shopping: 2 } }));
+  assert.ok(withCounts.includes('ch-tile-value">4<'));
+  assert.ok(withCounts.includes('ch-tile-value">2<'));
+  const missing = ctx(demo());
+  delete missing.counts;
+  assert.doesNotThrow(() => resumo.render(missing));
+});
+
+test('Resumo com valores ocultos não mostra montantes', () => {
+  const html = resumo.render(ctx(demo(), { state: { hidden: true } }));
+  assert.doesNotMatch(html, /\d,\d{2}\s?€/);
+});
