diff --git a/android/app/src/nav.cjs b/android/app/src/nav.cjs
new file mode 100644
index 0000000..53a6feb
--- /dev/null
+++ b/android/app/src/nav.cjs
@@ -0,0 +1,37 @@
+'use strict';
+const kit = require('./ui/kit.cjs');
+
+const MOVIMENTOS = ['movimentos', 'detalhe', 'novo', 'rascunho', 'eliminar', 'descartar-rascunho', 'conflito'];
+const CASA = ['casa', 'casa-form', 'descartar-casa', 'compras'];
+const MAIS = [
+  'mais', 'contas', 'conta', 'editar-conta', 'arquivar-conta', 'sair-conta',
+  'agenda', 'compromisso', 'novo-compromisso', 'pagar-compromisso', 'descartar-compromisso', 'descartar-pagamento',
+  'patrimonio', 'relatorios', 'avisos', 'sync', 'recuperacao',
+  'confirmar-recuperacao', 'confirmar-desligar', 'confirmar-passagem',
+  'consulta-financeira', 'definicoes',
+];
+
+// Separador da barra inferior a que uma página pertence; o que não está listado cai em «resumo».
+function tabFor(page) {
+  if (MOVIMENTOS.includes(page)) return 'movimentos';
+  if (CASA.includes(page)) return 'casa';
+  if (MAIS.includes(page)) return 'mais';
+  return 'resumo';
+}
+
+// Páginas cujo ecrã ainda não existe: mostram «Em breve». Quando uma tarefa registar o ecrã
+// real, basta retirar o nome daqui.
+const PLACEHOLDERS = { compras: 'Compras', patrimonio: 'Património', relatorios: 'Relatórios', avisos: 'Avisos', definicoes: 'Definições' };
+
+function isPlaceholder(page) {
+  return Object.prototype.hasOwnProperty.call(PLACEHOLDERS, page);
+}
+
+function placeholder(page) {
+  const title = PLACEHOLDERS[page] || 'Página';
+  const back = page === 'compras' ? ['casa', '‹ Casa'] : ['mais', '‹ Mais'];
+  return '<button type="button" class="back" data-page="' + back[0] + '">' + back[1] + '</button>'
+    + kit.card({ title, subtitle: 'Em breve', body: '<p class="sub">Esta página chega numa próxima atualização.</p>' });
+}
+
+module.exports = { tabFor, isPlaceholder, placeholder };
diff --git a/android/app/src/nav.test.cjs b/android/app/src/nav.test.cjs
new file mode 100644
index 0000000..f91565d
--- /dev/null
+++ b/android/app/src/nav.test.cjs
@@ -0,0 +1,34 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const nav = require('./nav.cjs');
+
+test('tabFor agrupa as páginas por separador', () => {
+  assert.equal(nav.tabFor('resumo'), 'resumo');
+  for (const p of ['movimentos', 'detalhe', 'novo', 'rascunho', 'eliminar', 'descartar-rascunho', 'conflito']) assert.equal(nav.tabFor(p), 'movimentos', p);
+  for (const p of ['casa', 'casa-form', 'descartar-casa', 'compras']) assert.equal(nav.tabFor(p), 'casa', p);
+  for (const p of ['contas', 'conta', 'editar-conta', 'arquivar-conta', 'sair-conta', 'agenda', 'compromisso', 'novo-compromisso', 'pagar-compromisso', 'descartar-compromisso', 'descartar-pagamento', 'patrimonio', 'relatorios', 'avisos', 'sync', 'recuperacao', 'confirmar-recuperacao', 'confirmar-desligar', 'confirmar-passagem', 'consulta-financeira', 'definicoes', 'mais']) assert.equal(nav.tabFor(p), 'mais', p);
+});
+
+test('tabFor devolve resumo para páginas desconhecidas', () => {
+  assert.equal(nav.tabFor('desconhecida'), 'resumo');
+  assert.equal(nav.tabFor(undefined), 'resumo');
+});
+
+test('placeholder «Em breve» só para páginas sem ecrã próprio', () => {
+  for (const p of ['compras', 'patrimonio', 'relatorios', 'avisos', 'definicoes']) {
+    assert.equal(nav.isPlaceholder(p), true, p);
+    const html = nav.placeholder(p);
+    assert.match(html, /Em breve/);
+    assert.match(html, p === 'compras' ? /data-page="casa"/ : /data-page="mais"/);
+  }
+  assert.equal(nav.isPlaceholder('contas'), false);
+  assert.equal(nav.isPlaceholder('mais'), false);
+});
+
+test('index.html usa a mesma navegação que a pré-visualização', () => {
+  const html = require('node:fs').readFileSync(require('node:path').join(__dirname, 'index.html'), 'utf8');
+  const shell = require('./shell.cjs');
+  assert.ok(html.includes(shell.navHtml('resumo') + shell.fabHtml()));
+  assert.match(shell.fabHtml(), /id="quickAdd" data-page="novo"/);
+});
