+  assert.match(html, /data-shopping-done="sh-1"[^>]*data-next="true"[^>]*aria-checked="false"/);
+  assert.match(html, /data-shopping-done="sh-2"[^>]*data-next="false"[^>]*aria-checked="true"/);
