+function seed(){const d=F.empty();d.accounts=[{id:'a',name:'Banco',type:'Banco',balance:1000}];F.migrateLedgerCore(d);const add=(id,type,amount,date)=>F.add(d,{id,type,amount,date,account:'Banco',description:id,category:'Casa'});add('feb','expense',40,'2026-02-10');add('mar','income',300,'2026-03-05');add('apr','expense',25,'2026-04-02');return d;}
