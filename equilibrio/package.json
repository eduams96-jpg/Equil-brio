      "entry-tips-ui.js",
      "mobile-connection-ui.js",
      "mobile-connection.css",
      "desktop/mobile-sync-runtime.cjs",
      "mobile-sync/server/desktop-bridge.cjs",
      "mobile-sync/server/listen.cjs",
      "mobile-sync/server/pairing.cjs",
      "mobile-sync/server/service.cjs",
      "mobile-sync/server/sqlite-store.cjs",
      "mobile-sync/shared/accounts.cjs",
      "mobile-sync/shared/association.cjs",
      "mobile-sync/shared/client.cjs",
      "mobile-sync/shared/commitment-drafts.cjs",
      "mobile-sync/shared/commitments.cjs",
      "mobile-sync/shared/compatibility.cjs",
      "mobile-sync/shared/drafts.cjs",
      "mobile-sync/shared/equality.cjs",
      "mobile-sync/shared/form-drafts.cjs",
      "mobile-sync/shared/house-form.cjs",
      "mobile-sync/shared/house.cjs",
      "mobile-sync/shared/movement-policy.cjs",
      "mobile-sync/shared/protocol.cjs",
      "mobile-sync/shared/recovery.cjs",
      "desktop/mobile-certificate.ps1",
      "desktop/shared-space-client.cjs",
      "mobile-sync/server/desktop-snapshot.cjs",
      "mobile-sync/server/snapshot-store.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Equilibrio-Setup-${version}.${ext}",
      "icon": "Equilibrio.ico",
      "executableName": "Equilibrio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Equilíbrio",
      "uninstallDisplayName": "Equilíbrio",
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "pt_PT"
      ],
      "language": "2070"
    },
    "compression": "maximum",
    "afterPack": "scripts/verify-packaged.cjs"
  }
}
