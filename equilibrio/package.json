      "vendor-receipts/tesseract.js/dist/tesseract.min.js",
      "vendor-receipts/tesseract.js/dist/worker.min.js",
      "vendor-receipts/tesseract.js-core/*.wasm",
      "vendor-receipts/tesseract.js-core/*.wasm.js",
      "vendor-receipts/pdfjs-dist/build/pdf.mjs",
      "vendor-receipts/pdfjs-dist/build/pdf.worker.mjs",
      "vendor-receipts/por.traineddata.gz",
      "vendor-receipts/por.traineddata",
      "package.json",
      "desktop/main.cjs",
      "desktop/ipc-guard.cjs",
      "desktop/attachment.cjs",
      "desktop/preload.cjs",
      "desktop/version.cjs",
      "desktop/migrations.cjs",
      "desktop/schema-migrations.cjs",
      "desktop/storage-sqlite.cjs",
      "desktop/data-service.cjs",
      "desktop/manual-updater.cjs",
      "desktop/update-recovery.cjs",
      "desktop/snapshot-backup.cjs",
      "desktop/encrypted-backup.cjs",
      "desktop/verified-backup.cjs",
      "casa-model.js",
