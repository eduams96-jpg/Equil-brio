{
  "name": "financas-pessoais-desktop",
  "version": "1.0.16",
  "private": true,
  "description": "Equilíbrio v1.0.16 — Correções Casa e Planeamento",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.cjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:check": "node scripts/check.cjs",
    "desktop:build:win": "electron-builder --win nsis",
    "test:release": "node scripts/validate-release.cjs",
    "diagnose": "node scripts/diagnose.cjs",
    "styles:build": "node scripts/build-styles.cjs",
    "styles:check": "node scripts/build-styles.cjs --check"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.28"
  },
  "build": {
    "appId": "pt.financaspessoais.desktop",
    "productName": "Equilíbrio",
    "asar": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
