      "assets/licenses/tesseract.js-dist_tesseract.min.js.LICENSE.txt",
      "assets/licenses/tesseract.js-dist_worker.min.js.LICENSE.txt",
      "scripts/verify-packaged.cjs",
      "dossiers-model.js",
